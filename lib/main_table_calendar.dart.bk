import 'dart:math';

import 'package:flutter/material.dart';
import 'package:indulge/models/encounter.dart';
import 'package:indulge/models/person.dart';
import 'package:indulge/util/database_engine.dart';
import 'package:sqflite/sqflite.dart';
import 'package:table_calendar/table_calendar.dart';
import 'models/sexual_encounter.dart';
import 'domain/data_access.dart';

void main() {
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'Flutter Demo',
      theme: ThemeData(
        colorScheme: ColorScheme.fromSeed(seedColor: Colors.blue),
        useMaterial3: true,
      ),
      home: const MyHomePage(title: 'Test App'),
    );
  }
}

class MyHomePage extends StatefulWidget {
  const MyHomePage({super.key, required this.title});
  final String title;

  @override
  State<MyHomePage> createState() => _MyHomePageState();
}

class _MyHomePageState extends State<MyHomePage> {
  final DataAccess dataAccess = DataAccess();
  DateTime _selectedDay = DateTime.now();
  DateTime _focusedDay = DateTime.now();
  late final ValueNotifier<List<Encounter>> _selectedEvents;
  List<Encounter> _eventsDuringCurrentPeriod = [];

  String _getEncounterEventPreviewString(Encounter encounter) {
    if (encounter is SexualEncounter) {
      String string = 'Sexual event with ';
      return '$string${encounter.personIds}';
    } else {
      return 'Some other type of event';
    }
  }

  DateTime _getEarliestEvent() {
    return DateTime(2024, 1, 1);
  }

  DateTime _getLatestEvent() {
    return DateTime(2025, 12, 31);
  }

  @override
  void initState() {
    super.initState();
    dataAccess.loadDatabase();
    _selectedDay = _focusedDay;
    _selectedEvents = ValueNotifier([]);
    // dataAccess.getEncountersInRange(startDate, endDate)
    dataAccess.getEncountersForDay(_selectedDay).then((encounters) {
      _selectedEvents = ValueNotifier(encounters);
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        backgroundColor: Theme.of(context).colorScheme.inversePrimary,
        title: Text(widget.title),
      ),
      body: Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.start,
          children: <Widget>[
            TableCalendar(
              focusedDay: _focusedDay,
              firstDay: _getEarliestEvent(),
              lastDay: _getLatestEvent(),
              selectedDayPredicate: (day) {
                return isSameDay(_selectedDay, day);
              },
              onDaySelected: (selectedDay, focusedDay) {
                setState(() {
                  _selectedDay = selectedDay;
                  _focusedDay = focusedDay;
                  dataAccess
                      .getEncountersForDay(selectedDay)
                      .then((encounters) => _selectedEvents.value = encounters);
                });
              },
              eventLoader: (day) {
                List<Encounter> encounters = [];
                dataAccess
                    .getEncountersForDay(day)
                    .then((value) => encounters = value);
                //TODO: This is not working, and I think it is because I am needing to await, but I cannot. I need to devise a way to load the entire month's data into the state and operate from that I think
                return encounters;
              },
              calendarFormat: CalendarFormat.month,
              availableCalendarFormats: const {CalendarFormat.month: "Month"},
              headerStyle: HeaderStyle(
                  decoration: BoxDecoration(
                      color: Theme.of(context).colorScheme.inversePrimary)),
            ),
            const SizedBox(height: 8.0),
            Expanded(
              child: ValueListenableBuilder<List<Encounter>>(
                valueListenable: _selectedEvents,
                builder: (context, value, _) {
                  return ListView.builder(
                    itemCount: value.length,
                    itemBuilder: (context, index) {
                      return Container(
                        margin: const EdgeInsets.symmetric(
                          horizontal: 12.0,
                          vertical: 4.0,
                        ),
                        decoration: BoxDecoration(
                          border: Border.all(),
                          borderRadius: BorderRadius.circular(12.0),
                        ),
                        child: ListTile(
                          onTap: () => print('${value[index]}'),
                          title: Text(
                              _getEncounterEventPreviewString(value[index])),
                        ),
                      );
                    },
                  );
                },
              ),
            ),
          ],
        ),
      ),
      floatingActionButton: FloatingActionButton(
        onPressed: () {},
        tooltip: 'Add a new encounter',
        child: const Icon(Icons.add),
      ),
    );
  }
}
